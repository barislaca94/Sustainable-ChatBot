# Local virtualenv should never be shipped in an image.
rasa-env/

# Local working material, never part of an image. Markdown files other than
# the README are notes, not code.
*.md
!README.md
docs/
evaluation/
Notes/
Checks/

# Test files and test output are not needed in an image.
results/
tests/

# Documents.
*.pdf
*.docx

# Python caches.
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# macOS metadata.
.DS_Store
.AppleDouble
.LSOverride

# IDE junk.
.vscode/
.idea/

# Secrets — pull via env_file in docker-compose instead.
.env
.env.local

# Measurement and data-fetching scripts are for maintainers; the JSON output
# under data/eco_data/ IS copied in.
scripts/
