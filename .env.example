# Copy this to .env and fill in real values. .env is git-ignored.

# Climatiq: live per-transport-mode carbon estimates (actions/actions.py,
# estimate_carbon). Optional: without a key, or when the call fails, the bot
# uses its local factor table (DESNZ and UBA factors) and says so in the reply.
# Free key at https://www.climatiq.io (free tier 2,500 calls/month, per the
# lecturer's Eco-Travel APIs guide).
# CLIMATIQ_API_KEY=

# The User-Agent that Nominatim and Overpass see. Nominatim's usage policy
# requires a User-Agent that identifies the application; the default names this
# repository. Overriding it here points complaints at the deployed instance.
# ECO_USER_AGENT=EcoTravelAdvisor/1.0 (you@example.com)
